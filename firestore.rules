rules_version = '2';
// A bank is only reachable by its id: the SHA-256 hash of your shared password
// (or a pair code from a link). Nobody can list banks, so the password is the key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /banks/{bank} {
      allow get, create, update: if bank.size() >= 20;
      match /{sub}/{entry} {
        allow read, write: if bank.size() >= 20 && sub in ['log', 'train'];
      }
    }
  }
}
